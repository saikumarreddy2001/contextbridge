# Frontend build-time origin. The code default is http://127.0.0.1:8077.
VITE_API_BASE_URL=http://127.0.0.1:8077

# Backend. Do not commit a real key or a service account.
ENVIRONMENT=development
ALLOWED_ORIGINS=http://127.0.0.1:43123,http://localhost:43123

# none | mock | openai | gemini
# An empty AI_MODEL uses gpt-4o-mini for openai and gemini-3.8-flash for gemini.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
